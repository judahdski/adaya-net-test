{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "AdayaOrderManagement": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        },
        "Console": {
            "FormatterName": "json",
            "FormatterOptions": {
                "IncludeScopes": true,
                "UseUtcTimestamp": true,
                "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
                "JsonWriterOptions": {
                    "Indented": false
                }
            }
        }
    },
    "AllowedHosts": "*"
}
